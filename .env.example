# Base mainnet deploy (required for make deploy-base)
BASE_RPC_URL=https://mainnet.base.org
# Hex private key with 0x prefix — fund this wallet with Base ETH for gas
DEPLOYER_PRIVATE_KEY=0xYOUR_PRIVATE_KEY_HERE
# Etherscan API key for verifying source
BASESCAN_API_KEY=
# Treasury / owner of the HTLC (fee recipient, sweep destination, admin). Defaults to deployer.
TREASURY_ADDRESS=0xE2a4465f7E9978bc38D6b792C87Ba519B47Bd42a

# VITE WEB VARIABLES
# Upstream for the Vite proxy (nockbox or nockchain public RPC)
VITE_NOCK_GRPC_UPSTREAM=https://rpc.nockchain.net
# Deployed AtomicNock HTLC on Base for USDC swaps (make deploy-base → paste address)
VITE_HTLC_ADDRESS=0x5ac37e7A63b107d226d0b88129B8EB8b07172B75
# AtomicNock HTLC instance for wNOCK swaps
VITE_HTLC_ADDRESS_WNOCK=0x606b807C32F15D28EB612eecB2A1603399a66545
VITE_CHAIN_ID=8453
# Ethereum mainnet RPC for ENS name lookups (must allow browser CORS). Optional —
# defaults to a CORS-friendly public endpoint.
VITE_ETH_RPC_URL=https://ethereum-rpc.publicnode.com
# Swap API (the Worker). LOCAL dev: run `npm --prefix worker run dev` and use
# http://localhost:8787. Empty = in-memory (ephemeral). Production = deployed URL.
VITE_KV_URL=http://localhost:8787
# (VITE_KV_TOKEN removed — writes are authorized by an Iris-signed session, not a
#  shared browser secret. The Worker holds SESSION_SECRET server-side only.)
# Optional market price feed (NOCK/USD). Empty = price hidden. See market/price.ts for shape.
VITE_PRICE_URL=https://api.coingecko.com/api/v3/simple/price?vs_currencies=usd&symbols=nock

# Browser push (VAPID). Generate a pair once: npx web-push generate-vapid-keys
# Public key goes here (and as a worker var VAPID_PUBLIC_KEY); the PRIVATE key is
# a worker secret only: npx wrangler secret put VAPID_PRIVATE_KEY
# Empty = the push option stays hidden in Settings.
VITE_VAPID_PUBLIC_KEY=BDCjukBFgMmy5W7a-yiyzxLf-CeHkRIrQIDoFb6ckjOT0XrYNmpO34qhTcAGnHsn8mQguhWgtEnZz0gXVcU93M8

# Worker-side notification config (set on the WORKER, not here — listed for reference):
#   npx wrangler secret put TELEGRAM_BOT_TOKEN       (from @BotFather)
#   npx wrangler secret put TELEGRAM_WEBHOOK_SECRET  (random string; also passed to setWebhook)
#   npx wrangler secret put VAPID_PRIVATE_KEY
#   vars: TELEGRAM_BOT_NAME, VAPID_PUBLIC_KEY, VAPID_SUBJECT (mailto:/https: contact)


# ── SOLVER DAEMON (separate repo: ~/atomic-nock-solver) ───────────────────────
# The solver runs on its own server with its own .env — see atomic-nock-solver.
# Worker var (wrangler.toml): comma-separated pkhs allowed to publish quotes and
# write solver state. Empty = any signed-in session. Set in production.
# SOLVER_PKHS=your-nock-pkh-here
