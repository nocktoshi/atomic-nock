# Base mainnet deploy (required for make deploy-base)
BASE_RPC_URL=https://mainnet.base.org
# Hex private key with 0x prefix — fund this wallet with Base ETH for gas
DEPLOYER_PRIVATE_KEY=0xYOUR_PRIVATE_KEY_HERE
# Etherscan API key for verifying source
BASESCAN_API_KEY=
# Treasury / owner of the HTLC (fee recipient, sweep destination, admin). Defaults to deployer.
TREASURY_ADDRESS=

# VITE WEB VARIABLES
VITE_ENVOY_URL=
# Upstream for the Vite proxy (nockbox or nockchain public RPC)
VITE_NOCK_GRPC_UPSTREAM=https://rpc.nockchain.net
# Deployed NockOtcHtlc on Base (make deploy-base → paste address from logs)
VITE_HTLC_ADDRESS=0x5ac37e7A63b107d226d0b88129B8EB8b07172B75
VITE_CHAIN_ID=8453
# Ethereum mainnet RPC for ENS name lookups (must allow browser CORS). Optional —
# defaults to a CORS-friendly public endpoint.
VITE_ETH_RPC_URL=https://ethereum-rpc.publicnode.com
# Swap API (the Worker). LOCAL dev: run `npm --prefix worker run dev` and use
# http://localhost:8787. Empty = in-memory (ephemeral). Production = deployed URL.
VITE_KV_URL=http://localhost:8787
# (VITE_KV_TOKEN removed — writes are authorized by an Iris-signed session, not a
#  shared browser secret. The Worker holds SESSION_SECRET server-side only.)
# Optional market price feed (NOCK/USD). Empty = price hidden. See market/price.ts for shape.
VITE_PRICE_URL=https://api.coingecko.com/api/v3/simple/price?vs_currencies=usd&symbols=nock

